+    @staticmethod
+    def _is_classic_dm(channel_type: str, channel_id: str) -> bool:
+        """Return True only for 1:1 DMs (channel_type='im' or D-prefix IDs).
+
+        Group DMs (channel_type='mpim') return False — they have multiple
+        participants, so each user's message must be evaluated for @-mention
