+    def _slack_ephemeral_recipients(self) -> list:
+        """Slack user IDs (U...) authorized to see ephemeral intermediate
+        output and approve sends in
+        ``ephemeral_intermediate_in_channels`` / ``approve_send_in_channels``.
+
+        Order-preserving list (each recipient is sent a copy of the message
+        via chat.postEphemeral). Accepts YAML list, CSV string, or env
+        ``SLACK_EPHEMERAL_RECIPIENTS``. Empty / unset → no recipients (sends
