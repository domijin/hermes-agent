+    # Legal values for default_channel_policy (Option A).
+    _VALID_CHANNEL_POLICIES = ("public", "ephemeral", "ephemeral_with_approval")
+
+    def _slack_default_channel_policy(self) -> str:
+        """Fall-through send() policy for channels in NONE of the explicit
+        allowlists (approve_send / ephemeral_intermediate / public_channels).
+        One of ``public`` / ``ephemeral`` / ``ephemeral_with_approval``.
+
+        Default if unset: ``public`` — back-compat, since the pre-Option-A
+        behavior posted unlisted channels publicly. Accepts the
+        ``default_channel_policy`` extra key or env override
+        ``SLACK_DEFAULT_CHANNEL_POLICY``. Unknown / malformed values are coerced
+        to ``public`` (a live send must never raise on a typo'd config). Option A.
+        """
+        raw = self.config.extra.get("default_channel_policy")
+        if raw is None:
+            raw = os.getenv("SLACK_DEFAULT_CHANNEL_POLICY", "")
+        policy = str(raw).strip().lower() if raw is not None else ""
+        if policy in self._VALID_CHANNEL_POLICIES:
+            return policy
+        if policy:
+            logger.warning(
+                "[Slack] invalid default_channel_policy %r — falling back to "
+                "'public' (legal values: %s)",
+                policy, ", ".join(self._VALID_CHANNEL_POLICIES),
+            )
+        return "public"
+
+    def _slack_public_channels(self) -> set:
+        """Channel IDs that explicitly opt OUT of a non-public
+        ``default_channel_policy`` and post publicly. Sits below the two
+        ephemeral lists and above the default in the precedence order. Same
+        parsing as the sibling readers; env override ``SLACK_PUBLIC_CHANNELS``.
+        Empty / unset disables. Option A.
+        """
+        raw = self.config.extra.get("public_channels")
+        if raw is None:
+            raw = os.getenv("SLACK_PUBLIC_CHANNELS", "")
+        if isinstance(raw, list):
+            return {str(p).strip() for p in raw if str(p).strip()}
+        s = str(raw).strip() if raw is not None else ""
+        if s:
+            return {p.strip() for p in s.split(",") if p.strip()}
+        return set()
+
+    def _channel_policy(self, chat_id: str) -> str:
+        """Resolve the effective send policy for ``chat_id`` via the locked
+        precedence (FIRST match wins):
+
+        1. ``approve_send_in_channels``         → ``ephemeral_with_approval``
+        2. ``ephemeral_intermediate_in_channels`` → ``ephemeral``
+        3. ``public_channels``                  → ``public``
+        4. otherwise                            → ``default_channel_policy``
+
+        The explicit lists are matched WITHOUT regard to ``is_final``; the
+        is_final coupling for the approval gate lives in ``send()`` (the gate
+        fires only on the canonical turn-final send — intermediates stay
+        ephemeral). Option A.
+        """
+        if chat_id in self._slack_approve_send_in_channels():
+            return "ephemeral_with_approval"
+        if chat_id in self._slack_ephemeral_intermediate_in_channels():
+            return "ephemeral"
+        if chat_id in self._slack_public_channels():
+            return "public"
+        return self._slack_default_channel_policy()
+
+    async def _send_ephemeral_to_recipients(
+        self,
+        chat_id: str,
+        content: str,
+        metadata: Optional[Dict[str, Any]] = None,
+    ) -> SendResult:
+        """Send ``content`` ephemerally to every user in ephemeral_recipients.
+
+        Used when chat_id is in ephemeral_intermediate_in_channels. Channel
+        members other than the recipients see nothing. If no recipients are
+        configured, log a warning and drop the message silently (better than
+        leaking to the public channel — matches operator intent).
+        """
+        recipients = self._slack_ephemeral_recipients()
+        if not recipients:
+            logger.warning(
+                "[Slack] ephemeral_intermediate_in_channels includes %s but "
+                "ephemeral_recipients is empty — message dropped (refuses to "
+                "fall back to public post).",
+                chat_id,
+            )
+            return SendResult(success=True, message_id=None, error="no-recipients-configured")
+
+        formatted = self.format_message(content)
+        chunks = self.truncate_message(formatted, self.MAX_MESSAGE_LENGTH)
+        thread_ts = self._resolve_thread_ts(None, metadata)
+
+        for chunk in chunks:
+            for user_id in recipients:
+                kwargs: Dict[str, Any] = {
+                    "channel": chat_id,
+                    "user": user_id,
+                    "text": chunk,
+                }
+                if thread_ts:
+                    kwargs["thread_ts"] = thread_ts
+                try:
+                    await self._get_client(chat_id).chat_postEphemeral(**kwargs)
+                except Exception as e:
+                    logger.warning(
+                        "[Slack] chat_postEphemeral failed for user %s in %s: %s",
+                        user_id, chat_id, e,
+                    )
+        return SendResult(success=True, message_id=None)
+
+    async def _send_await_send_approval(
+        self,
+        chat_id: str,
+        content: str,
+        metadata: Optional[Dict[str, Any]] = None,
+        timeout: float = 600.0,
+    ) -> bool:
+        """Post an ephemeral Approve/Deny prompt to ephemeral_recipients; block
+        until a button is clicked (or timeout). Returns True on Approve,
+        False on Deny / timeout / no-recipients-configured.
+
+        Reuses the Block Kit action_id pattern from send_exec_approval. Each
+        prompt has a unique approval_key value attached to the buttons so
+        clicks resolve the right asyncio.Event.
+        """
+        recipients = self._slack_ephemeral_recipients()
+        if not recipients:
+            logger.warning(
+                "[Slack] approve_send_in_channels includes %s but "
+                "ephemeral_recipients is empty — denying by default "
+                "(no one to ask).",
+                chat_id,
+            )
+            return False
+
+        preview = content if len(content) <= 2900 else content[:2900] + "..."
+        thread_ts = self._resolve_thread_ts(None, metadata)
+        approval_key = (
+            f"send-approval:{chat_id}:"
+            f"{int(asyncio.get_event_loop().time() * 1000)}"
+        )
+        event = asyncio.Event()
+        self._send_approval_events[approval_key] = event
+
+        blocks = [
+            {
+                "type": "section",
+                "text": {
+                    "type": "mrkdwn",
+                    "text": (
+                        f":eyes: *Approve public post to <#{chat_id}>?*\n"
+                        f"```{preview}```"
+                    ),
+                },
+            },
+            {
+                "type": "actions",
+                "elements": [
+                    {
+                        "type": "button",
+                        "text": {"type": "plain_text", "text": "Approve"},
+                        "style": "primary",
+                        "action_id": "hermes_send_approve",
+                        "value": approval_key,
+                    },
+                    {
+                        "type": "button",
+                        "text": {"type": "plain_text", "text": "Deny"},
+                        "style": "danger",
+                        "action_id": "hermes_send_deny",
+                        "value": approval_key,
+                    },
+                ],
+            },
+        ]
+
+        post_kwargs: Dict[str, Any] = {
+            "channel": chat_id,
+            "text": "Approve public post?",
+            "blocks": blocks,
+        }
+        if thread_ts:
+            post_kwargs["thread_ts"] = thread_ts
+
+        for user_id in recipients:
+            try:
+                await self._get_client(chat_id).chat_postEphemeral(
+                    user=user_id, **post_kwargs,
+                )
+            except Exception as e:
+                logger.warning(
+                    "[Slack] approval prompt postEphemeral failed for %s: %s",
+                    user_id, e,
+                )
+
+        try:
+            await asyncio.wait_for(event.wait(), timeout=timeout)
+            return bool(self._send_approval_results.get(approval_key, False))
+        except asyncio.TimeoutError:
+            logger.warning(
+                "[Slack] send-approval timed out after %.0fs for %s — denying.",
+                timeout, chat_id,
+            )
+            return False
+        finally:
+            self._send_approval_events.pop(approval_key, None)
+            self._send_approval_results.pop(approval_key, None)
+
+    async def _handle_send_approval_action(self, ack, body, action, respond=None) -> None:
+        """Block Kit button-click handler for hermes_send_approve /
+        hermes_send_deny. Sets the corresponding asyncio.Event keyed by
+        approval_key (carried in the button's ``value``), then replaces
+        the ephemeral prompt with a confirmation so the buttons don't
+        linger after the click.
+
+        Slack ephemeral messages can only be updated via the action's
+        ``response_url``; ``chat_update`` is rejected for ephemerals. We
+        use slack-bolt's ``respond`` callback which posts to that URL.
+        """
+        await ack()
+        action_id = action.get("action_id", "")
+        approval_key = action.get("value", "")
+        if not approval_key:
+            return
+        event = self._send_approval_events.get(approval_key)
+        if event is None:
+            # Prompt expired or already resolved.
+            return
+        # Defense-in-depth: Slack ephemeral visibility already restricts who can
+        # see + click the prompt, but verify the clicker is on the allowlist.
+        user_id = body.get("user", {}).get("id", "")
+        user_name = body.get("user", {}).get("name") or user_id or "unknown"
+        allowed = set(self._slack_ephemeral_recipients())
+        if allowed and user_id not in allowed:
+            logger.warning(
+                "[Slack] unauthorized send-approval click by %s — ignoring.",
+                user_id,
+            )
+            return
+        approved = action_id == "hermes_send_approve"
+        self._send_approval_results[approval_key] = approved
+        event.set()
+
+        # Replace the prompt with a confirmation so buttons don't linger.
+        # ``respond`` is injected by slack-bolt with the action's
+        # ``response_url``; it may be absent in unit tests — skip silently.
+        if respond is None:
+            return
+        decision_text = (
+            f"✅ Approved by {user_name} — posting publicly."
+            if approved
+            else f"❌ Denied by {user_name} — no public post."
+        )
+        # Preserve the original draft text from the prompt's section block
+        # so the operator can still see what they approved after the
+        # buttons are removed.
+        original_text = ""
+        try:
+            for block in body.get("message", {}).get("blocks", []) or []:
+                if block.get("type") == "section":
+                    txt = block.get("text") or {}
+                    if isinstance(txt, dict):
+                        original_text = txt.get("text", "")
+                    break
+        except Exception:
+            original_text = ""
+        updated_blocks = [
+            {
+                "type": "section",
+                "text": {
+                    "type": "mrkdwn",
+                    "text": original_text or decision_text,
+                },
+            },
+            {
+                "type": "context",
+                "elements": [{"type": "mrkdwn", "text": decision_text}],
+            },
+        ]
+        try:
+            await respond(
+                replace_original=True,
+                text=decision_text,
+                blocks=updated_blocks,
+            )
+        except Exception as e:
+            logger.warning("[Slack] Failed to update send-approval prompt: %s", e)
+
+    # --- end domi-local-patch ---
